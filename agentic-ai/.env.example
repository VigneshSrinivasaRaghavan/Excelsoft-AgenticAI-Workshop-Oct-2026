# Provider Options: openai | google | ollama | groq | qwen
PROVIDER=google

# Model names:
# Gwen: qwen3.6-plus
# OpenAI: gpt-4o | gpt-4o-mini
# Google: gemini-1.5-pro | gemini-2.0-flash-exp
# Ollama: mistral:latest | llama3 | codellama
MODEL=qwen3.6-plus

# OpenAI API Key (get from: <https://platform.openai.com/api-keys>)
OPENAI_API_KEY=

# Google Gemini API Key (get from: <https://aistudio.google.com/apikey>)
GOOGLE_API_KEY=

# Anthropic API Key (get from: <https://console.anthropic.com/api-keys>)
ANTHROPIC_API_KEY=

# Groq API Key (get from: <https://groq.com/api-keys>)
GROQ_API_KEY=

# Qwen API Key (get from: <https://qwen.aliyun.com/api-keys>)
QWEN_API_KEY=

# Qwen Base URL (get from: <https://qwen.aliyun.com/api-keys>)
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Ollama Host (only for local Ollama)
OLLAMA_HOST=http://localhost:11434